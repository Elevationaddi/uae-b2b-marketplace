{
  "name": "@app/db",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "echo 'db: covered by api integration tests'",
    "db:migrate": "node ../../scripts/with-env.mjs prisma migrate deploy",
    "db:migrate:dev": "node ../../scripts/with-env.mjs prisma migrate dev",
    "db:migrate:status": "node ../../scripts/with-env.mjs prisma migrate status",
    "db:seed": "node ../../scripts/with-env.mjs tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
