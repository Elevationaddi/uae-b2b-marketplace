// Prisma schema. Logical model: docs/06-data.md.
// Tables are added with their vertical slices through reviewed migrations.
// Phase 1: identity, sessions, companies, workspaces, memberships, invitations,
// verification, private files, admin roles/MFA, audit log and outbox.
// Conventions: UUID ids, timestamptz (UTC), snake_case table/column names,
// RESTRICT on historical foreign keys.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  COMPANY
  PLATFORM_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Locale {
  en
  ar
}

enum SessionScope {
  COMPANY
  ADMIN
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum CompanyStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFO
  REJECTED
  APPROVED
  SUSPENDED
}

enum SuspensionKind {
  LICENCE_EXPIRED
  COMPLIANCE
}

enum Emirate {
  ABU_DHABI
  DUBAI
  SHARJAH
  AJMAN
  UMM_AL_QUWAIN
  RAS_AL_KHAIMAH
  FUJAIRAH
}

enum WorkspaceKind {
  BUYER
  SELLER
}

enum WorkspaceStatus {
  PENDING
  ACTIVE
  RESTRICTED
}

enum MembershipRole {
  OWNER
  PROCUREMENT
  VIEWER
  SALES
  WAREHOUSE
  FINANCE
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum VerificationKind {
  INITIAL
  RENEWAL
}

enum VerificationState {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFO
  REJECTED
  APPROVED
  CLOSED
}

enum DocumentType {
  TRADE_LICENCE
  AUTHORIZED_REPRESENTATIVE
  OTHER
}

enum ScanState {
  PENDING
  CLEAN
  INFECTED
}

enum FileVisibility {
  PRIVATE
  /// Separate media bucket; served publicly only while attached to approved, visible content.
  MEDIA
}

enum FilePurpose {
  VERIFICATION_DOCUMENT
  PRODUCT_IMAGE
  STOREFRONT_IMAGE
  CATEGORY_IMAGE
  RFQ_ATTACHMENT
  QUOTE_ATTACHMENT
  MESSAGE_ATTACHMENT
  DELIVERY_PROOF
  DISPUTE_EVIDENCE
}

enum CategoryRestriction {
  OPEN
  REVIEW_REQUIRED
  BLOCKED
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

enum BusinessType {
  MANUFACTURER
  FACTORY
  WHOLESALER
  DISTRIBUTOR
  IMPORTER
  AUTHORIZED_DISTRIBUTOR
  TRADING_COMPANY
}

enum StorefrontStatus {
  DRAFT
  PUBLISHED
}

enum StorefrontMediaKind {
  LOGO
  COVER
  FACTORY
  WAREHOUSE
  OTHER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  SUSPENDED
  ARCHIVED
  REMOVED
}

enum VersionState {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SUPERSEDED
  WITHDRAWN
}

enum FulfilmentMode {
  READY_STOCK
  MADE_TO_ORDER
}

enum PriceType {
  FIXED
  TIERED
  QUOTE_ONLY
}

enum QuantityUnit {
  PIECE
  CARTON
  BOX
  PACK
  SET
  PAIR
  ROLL
  DOZEN
}

enum StockMovementKind {
  RECEIVE
  REMOVE
  MARK_UNAVAILABLE
  RELEASE_UNAVAILABLE
  SET_ON_HAND
  RESERVE
  RELEASE_RESERVATION
  SALE
}

enum RestrictedAction {
  BLOCK
  REVIEW
}

enum FeaturedKind {
  PRODUCT
  SUPPLIER
}

enum ListingView {
  GRID
  LIST
}

enum AdminRole {
  COMPLIANCE
  SUPPORT
  FINANCE
  FINANCE_APPROVER
  SUPER_ADMIN
}

enum OutboxState {
  PENDING
  DONE
  DEAD
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  /// Stored lower-cased and trimmed; unique.
  email           String      @unique
  passwordHash    String?     @map("password_hash")
  emailVerifiedAt DateTime?   @map("email_verified_at") @db.Timestamptz(3)
  locale          Locale      @default(en)
  status          UserStatus  @default(ACTIVE)
  accountType     AccountType @default(COMPANY) @map("account_type")
  fullName        String?     @map("full_name")
  mfaEnabled      Boolean     @default(false) @map("mfa_enabled")
  /// AES-256-GCM encrypted TOTP secret (iv.tag.ciphertext, base64url). Never returned by the API.
  mfaSecretEnc    String?     @map("mfa_secret_enc")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions         Session[]
  tokens           UserToken[]
  recoveryCodes    MfaRecoveryCode[]
  memberships      Membership[]
  adminMemberships AdminMembership[]

  @@map("users")
}

model Session {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  tokenHash     String       @unique @map("token_hash")
  scope         SessionScope
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(3)
  lastSeenAt    DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  mfaVerifiedAt DateTime?    @map("mfa_verified_at") @db.Timestamptz(3)
  revokedAt     DateTime?    @map("revoked_at") @db.Timestamptz(3)
  ip            String?
  userAgent     String?      @map("user_agent")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model UserToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("user_tokens")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model Company {
  id                     String                @id @default(uuid()) @db.Uuid
  legalName              String                @map("legal_name")
  displayName            String                @map("display_name")
  licenceNumber          String                @map("licence_number")
  licenceIssuer          String                @map("licence_issuer")
  licenceExpiry          DateTime              @map("licence_expiry") @db.Date
  activity               String
  emirate                Emirate
  trn                    String?
  /// Supplier VAT registration (F05, C-08). Declared by the company; confirmed by compliance.
  vatStatus              VatRegistrationStatus @default(UNKNOWN) @map("vat_status")
  vatStatusConfirmedAt   DateTime?             @map("vat_status_confirmed_at") @db.Timestamptz(3)
  vatStatusConfirmedById String?               @map("vat_status_confirmed_by_id") @db.Uuid
  /// Admin exception to the open support ticket limit (C-17); null means the default.
  supportTicketLimit     Int?                  @map("support_ticket_limit")
  status                 CompanyStatus         @default(DRAFT)
  suspensionKind         SuspensionKind?       @map("suspension_kind")
  /// Last 30-day licence expiry reminder sent for this expiry date (dedupe).
  licenceReminderFor     DateTime?             @map("licence_reminder_for") @db.Date
  contactEmail           String                @map("contact_email")
  contactPhone           String                @map("contact_phone")
  termsVersion           String?               @map("terms_version")
  termsAcceptedAt        DateTime?             @map("terms_accepted_at") @db.Timestamptz(3)
  /// Optimistic concurrency token; incremented on every update.
  version                Int                   @default(1)
  createdById            String                @map("created_by_id") @db.Uuid
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspaces        Workspace[]
  verificationCases VerificationCase[]
  files             File[]
  products          Product[]

  @@unique([licenceIssuer, licenceNumber])
  @@index([status, licenceExpiry])
  @@map("companies")
}

model Workspace {
  id        String          @id @default(uuid()) @db.Uuid
  companyId String          @map("company_id") @db.Uuid
  kind      WorkspaceKind
  status    WorkspaceStatus @default(PENDING)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company             Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  memberships         Membership[]
  invitations         Invitation[]
  storefront          Storefront?
  products            Product[]
  rfqs                Rfq[]          @relation("RfqBuyer")
  rfqInvites          RfqInvite[]    @relation("RfqInviteSeller")
  quotes              Quote[]        @relation("QuoteSeller")
  buyerConversations  Conversation[] @relation("ConversationBuyer")
  sellerConversations Conversation[] @relation("ConversationSeller")

  @@unique([companyId, kind])
  @@map("workspaces")
}

model Membership {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        MembershipRole
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  email       String
  role        MembershipRole
  tokenHash   String         @unique @map("token_hash")
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?      @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime?      @map("revoked_at") @db.Timestamptz(3)
  invitedById String         @map("invited_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, email])
  @@map("invitations")
}

model VerificationCase {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  kind            VerificationKind  @default(INITIAL)
  state           VerificationState @default(DRAFT)
  assignedAdminId String?           @map("assigned_admin_id") @db.Uuid
  submittedAt     DateTime?         @map("submitted_at") @db.Timestamptz(3)
  decidedAt       DateTime?         @map("decided_at") @db.Timestamptz(3)
  reason          String?
  /// Renewal only: proposed licence fields applied to the company on approval.
  proposed        Json?
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  documents VerificationDocument[]
  events    VerificationCaseEvent[]

  // "One active case per company" is enforced by a partial unique index in the migration.
  @@index([companyId, state])
  @@index([state, submittedAt])
  @@map("verification_cases")
}

model VerificationCaseEvent {
  id        String             @id @default(uuid()) @db.Uuid
  caseId    String             @map("case_id") @db.Uuid
  actorId   String?            @map("actor_id") @db.Uuid
  fromState VerificationState? @map("from_state")
  toState   VerificationState  @map("to_state")
  reason    String?
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  case VerificationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@map("verification_case_events")
}

model File {
  id             String         @id @default(uuid()) @db.Uuid
  ownerCompanyId String?        @map("owner_company_id") @db.Uuid
  uploaderId     String         @map("uploader_id") @db.Uuid
  objectKey      String         @unique @map("object_key")
  originalName   String         @map("original_name")
  mime           String
  bytes          Int
  sha256         String
  scanState      ScanState      @default(PENDING) @map("scan_state")
  visibility     FileVisibility @default(PRIVATE)
  purpose        FilePurpose    @default(VERIFICATION_DOCUMENT)
  width          Int?
  height         Int?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  ownerCompany          Company?               @relation(fields: [ownerCompanyId], references: [id], onDelete: Restrict)
  verificationDocuments VerificationDocument[]
  rfqFiles              RfqFile[]              @relation("RfqFileFile")
  quoteFiles            QuoteFile[]            @relation("QuoteFileFile")
  message               Message?               @relation("MessageFile")

  @@index([ownerCompanyId])
  @@map("files")
}

model VerificationDocument {
  id        String       @id @default(uuid()) @db.Uuid
  caseId    String       @map("case_id") @db.Uuid
  fileId    String       @map("file_id") @db.Uuid
  type      DocumentType
  expiresAt DateTime?    @map("expires_at") @db.Date
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  case VerificationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  file File             @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@map("verification_documents")
}

model AdminMembership {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      AdminRole
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, role])
  @@map("admin_memberships")
}

/// Append-only. UPDATE and DELETE are rejected by a database trigger.
model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorType    String   @map("actor_type")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  companyId    String?  @map("company_id") @db.Uuid
  reason       String?
  redactedDiff Json?    @map("redacted_diff")
  requestId    String?  @map("request_id")
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

model OutboxEvent {
  id            String      @id @default(uuid()) @db.Uuid
  eventType     String      @map("event_type")
  aggregateId   String?     @map("aggregate_id")
  /// Cleared (redacted) after successful delivery because it can carry one-time links.
  payload       Json
  state         OutboxState @default(PENDING)
  attempts      Int         @default(0)
  lastError     String?     @map("last_error")
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  dedupeKey     String?     @unique @map("dedupe_key")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt   DateTime?   @map("processed_at") @db.Timestamptz(3)

  @@index([state, nextAttemptAt])
  @@map("outbox")
}

// ---------------------------------------------------------------------------------------------
// Phase 2: catalog, storefronts, inventory, moderation, buyer lists (docs/06-data.md, A09–A12).
// Money: BigInt fils (AED). Quantities: whole units (Int) for the MVP unit set.
// ---------------------------------------------------------------------------------------------

/// Two-level tree (top-level category -> subcategory), enforced by trigger. Managed in admin (A09).
model Category {
  id             String              @id @default(uuid()) @db.Uuid
  parentId       String?             @map("parent_id") @db.Uuid
  slug           String              @unique
  nameEn         String              @map("name_en")
  nameAr         String              @map("name_ar")
  descriptionEn  String?             @map("description_en")
  descriptionAr  String?             @map("description_ar")
  imageFileId    String?             @map("image_file_id") @db.Uuid
  position       Int                 @default(0)
  visible        Boolean             @default(true)
  /// Priority category for supplier acquisition (A09).
  priority       Boolean             @default(false)
  restriction    CategoryRestriction @default(OPEN)
  /// Category-specific documentation / requirements shown to sellers (A10).
  requirementsEn String?             @map("requirements_en")
  requirementsAr String?             @map("requirements_ar")
  archivedAt     DateTime?           @map("archived_at") @db.Timestamptz(3)
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]          @relation("CategoryTree")
  attributes CategoryAttribute[]
  versions   ProductVersion[]
  rfqs       Rfq[]

  @@index([parentId, position])
  @@map("categories")
}

model CategoryAttribute {
  id         String        @id @default(uuid()) @db.Uuid
  categoryId String        @map("category_id") @db.Uuid
  key        String
  labelEn    String        @map("label_en")
  labelAr    String        @map("label_ar")
  type       AttributeType
  /// SELECT only: [{ value, label_en, label_ar }].
  options    Json          @default("[]")
  unit       String?
  required   Boolean       @default(false)
  filterable Boolean       @default(false)
  position   Int           @default(0)
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([categoryId, key])
  @@map("category_attributes")
}

/// Supplier storefront (one per seller workspace). Public only while published, not hidden by an
/// admin, and the company is approved with a valid licence.
model Storefront {
  id                    String           @id @default(uuid()) @db.Uuid
  sellerWorkspaceId     String           @unique @map("seller_workspace_id") @db.Uuid
  companyId             String           @map("company_id") @db.Uuid
  status                StorefrontStatus @default(DRAFT)
  businessType          BusinessType?    @map("business_type")
  descriptionEn         String?          @map("description_en")
  descriptionAr         String?          @map("description_ar")
  yearEstablished       Int?             @map("year_established")
  city                  String?
  specializationEn      String?          @map("specialization_en")
  specializationAr      String?          @map("specialization_ar")
  capabilitiesEn        String?          @map("capabilities_en")
  capabilitiesAr        String?          @map("capabilities_ar")
  productionCapacity    String?          @map("production_capacity")
  customizationServices Boolean          @default(false) @map("customization_services")
  privateLabel          Boolean          @default(false) @map("private_label")
  whiteLabel            Boolean          @default(false) @map("white_label")
  samplesAvailable      Boolean          @default(false) @map("samples_available")
  fulfilmentEn          String?          @map("fulfilment_en")
  fulfilmentAr          String?          @map("fulfilment_ar")
  /// [{ name, issuer, valid_until? }] supplier-declared; shown as declared, not platform-verified.
  certifications        Json             @default("[]")
  /// Phase 4 delivery terms (provisional P4-1): one flat fee per order and the emirates served.
  deliveryFeeFils       BigInt?          @map("delivery_fee_fils")
  deliveryEmirates      Emirate[]        @default([]) @map("delivery_emirates")
  deliveryDays          Int?             @map("delivery_days")
  /// Disclosed change-of-mind return policy (C-11), shown before payment and copied onto orders.
  returnPolicyEn        String?          @map("return_policy_en")
  returnPolicyAr        String?          @map("return_policy_ar")
  publishedAt           DateTime?        @map("published_at") @db.Timestamptz(3)
  adminHiddenAt         DateTime?        @map("admin_hidden_at") @db.Timestamptz(3)
  adminHiddenReason     String?          @map("admin_hidden_reason")
  version               Int              @default(1)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace         @relation(fields: [sellerWorkspaceId], references: [id], onDelete: Restrict)
  media     StorefrontMedia[]

  @@index([status])
  @@map("storefronts")
}

model StorefrontMedia {
  id           String              @id @default(uuid()) @db.Uuid
  storefrontId String              @map("storefront_id") @db.Uuid
  fileId       String              @map("file_id") @db.Uuid
  kind         StorefrontMediaKind
  position     Int                 @default(0)
  captionEn    String?             @map("caption_en")
  captionAr    String?             @map("caption_ar")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  storefront Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@index([storefrontId, kind, position])
  @@map("storefront_media")
}

/// A listing. Content lives in moderated product_versions; pricing, stock and availability are
/// live, validated and audited (A11). Public visibility is defined once, in the
/// marketplace_products view.
model Product {
  id                     String         @id @default(uuid()) @db.Uuid
  sellerWorkspaceId      String         @map("seller_workspace_id") @db.Uuid
  companyId              String         @map("company_id") @db.Uuid
  status                 ProductStatus  @default(DRAFT)
  statusBeforeSuspension ProductStatus? @map("status_before_suspension")
  statusReason           String?        @map("status_reason")
  priceType              PriceType      @default(FIXED) @map("price_type")
  publishedVersionId     String?        @unique @map("published_version_id") @db.Uuid
  workingVersionId       String?        @unique @map("working_version_id") @db.Uuid
  /// Denormalised from live pricing for filtering/sorting (refreshed in the same transaction).
  minPriceFils           BigInt?        @map("min_price_fils")
  minMoq                 Int?           @map("min_moq")
  version                Int            @default(1)
  createdById            String         @map("created_by_id") @db.Uuid
  firstPublishedAt       DateTime?      @map("first_published_at") @db.Timestamptz(3)
  publishedAt            DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace        Workspace        @relation(fields: [sellerWorkspaceId], references: [id], onDelete: Restrict)
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "products_company_fk")
  publishedVersion ProductVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  workingVersion   ProductVersion?  @relation("WorkingVersion", fields: [workingVersionId], references: [id], onDelete: Restrict)
  versions         ProductVersion[] @relation("ProductVersions")
  skus             Sku[]

  @@index([sellerWorkspaceId, status])
  @@index([status, publishedAt])
  @@map("products")
}

/// Moderated listing content. A submitted version is the moderation case (queue = PENDING_REVIEW).
/// Approved/superseded/rejected content is immutable (trigger).
model ProductVersion {
  id                  String         @id @default(uuid()) @db.Uuid
  productId           String         @map("product_id") @db.Uuid
  version             Int
  state               VersionState   @default(DRAFT)
  titleEn             String         @map("title_en")
  titleAr             String?        @map("title_ar")
  descriptionEn       String         @default("") @map("description_en")
  descriptionAr       String?        @map("description_ar")
  categoryId          String         @map("category_id") @db.Uuid
  mode                FulfilmentMode @default(READY_STOCK)
  attributes          Json           @default("{}")
  /// [{ label_en, label_ar?, value }]
  specifications      Json           @default("[]")
  materials           String?
  dimensions          String?
  countryOfOrigin     String?        @map("country_of_origin")
  leadTimeMinDays     Int?           @map("lead_time_min_days")
  leadTimeMaxDays     Int?           @map("lead_time_max_days")
  fulfilmentDays      Int?           @map("fulfilment_days")
  customManufacturing Boolean        @default(false) @map("custom_manufacturing")
  privateLabel        Boolean        @default(false) @map("private_label")
  whiteLabel          Boolean        @default(false) @map("white_label")
  samplesAvailable    Boolean        @default(false) @map("samples_available")
  sampleNote          String?        @map("sample_note")
  /// [{ name, issuer, number?, valid_until? }] supplier-declared.
  certifications      Json           @default("[]")
  videoUrl            String?        @map("video_url")
  /// Generated column (mkt_normalize of titles/descriptions); read-only.
  searchText          String?        @map("search_text")
  /// Automatic moderation flags, e.g. restricted-term matches: [{ kind, term, field }].
  autoFlags           Json           @default("[]") @map("auto_flags")
  createdById         String         @map("created_by_id") @db.Uuid
  submittedAt         DateTime?      @map("submitted_at") @db.Timestamptz(3)
  submittedById       String?        @map("submitted_by_id") @db.Uuid
  decidedAt           DateTime?      @map("decided_at") @db.Timestamptz(3)
  decidedById         String?        @map("decided_by_id") @db.Uuid
  decisionReason      String?        @map("decision_reason")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  product      Product        @relation("ProductVersions", fields: [productId], references: [id], onDelete: Restrict)
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media        ProductMedia[]
  publishedFor Product?       @relation("PublishedVersion")
  workingFor   Product?       @relation("WorkingVersion")

  @@unique([productId, version])
  @@index([state, submittedAt])
  @@map("product_versions")
}

model ProductMedia {
  id               String   @id @default(uuid()) @db.Uuid
  productVersionId String   @map("product_version_id") @db.Uuid
  fileId           String   @map("file_id") @db.Uuid
  /// Unique per version via a DEFERRABLE constraint in the migration (allows reordering).
  position         Int
  altEn            String?  @map("alt_en")
  altAr            String?  @map("alt_ar")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  version ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)

  @@index([productVersionId, position])
  @@index([fileId])
  @@map("product_media")
}

/// Sellable variant. Identity (code, variant attributes, unit) is fixed once approved; a SKU added
/// to a published product stays pending (approved_at null) until its version is approved.
model Sku {
  id                String       @id @default(uuid()) @db.Uuid
  productId         String       @map("product_id") @db.Uuid
  sellerWorkspaceId String       @map("seller_workspace_id") @db.Uuid
  code              String
  /// { attribute: value } e.g. { "colour": "Blue", "size": "M" }
  variantAttributes Json         @default("{}") @map("variant_attributes")
  unit              QuantityUnit @default(PIECE)
  moq               Int          @default(1)
  orderIncrement    Int          @default(1) @map("order_increment")
  active            Boolean      @default(true)
  approvedAt        DateTime?    @map("approved_at") @db.Timestamptz(3)
  lowStockThreshold Int          @default(0) @map("low_stock_threshold")
  restockAt         DateTime?    @map("restock_at") @db.Date
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  tiers     PriceTier[]
  inventory Inventory?
  movements StockMovement[]

  @@unique([sellerWorkspaceId, code])
  @@index([productId])
  @@map("skus")
}

model PriceTier {
  id            String   @id @default(uuid()) @db.Uuid
  skuId         String   @map("sku_id") @db.Uuid
  minQty        Int      @map("min_qty")
  unitPriceFils BigInt   @map("unit_price_fils")
  currency      String   @default("AED")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([skuId, minQty])
  @@map("price_tiers")
}

/// available = on_hand - reserved - unavailable (never negative; CHECK constraints).
model Inventory {
  id          String   @id @default(uuid()) @db.Uuid
  skuId       String   @unique @map("sku_id") @db.Uuid
  onHand      Int      @default(0) @map("on_hand")
  reserved    Int      @default(0)
  unavailable Int      @default(0)
  sold        Int      @default(0)
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

/// Append-only stock ledger (trigger).
model StockMovement {
  id               String            @id @default(uuid()) @db.Uuid
  skuId            String            @map("sku_id") @db.Uuid
  actorId          String?           @map("actor_id") @db.Uuid
  kind             StockMovementKind
  deltaOnHand      Int               @map("delta_on_hand")
  deltaReserved    Int               @default(0) @map("delta_reserved")
  deltaUnavailable Int               @default(0) @map("delta_unavailable")
  onHandAfter      Int               @map("on_hand_after")
  reservedAfter    Int               @map("reserved_after")
  unavailableAfter Int               @map("unavailable_after")
  reason           String
  referenceId      String?           @map("reference_id")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@index([skuId, createdAt])
  @@map("stock_movements")
}

/// Append-only moderation and enforcement history for listings and storefronts (trigger).
model ModerationEvent {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String?  @map("product_id") @db.Uuid
  productVersionId String?  @map("product_version_id") @db.Uuid
  storefrontId     String?  @map("storefront_id") @db.Uuid
  actorId          String?  @map("actor_id") @db.Uuid
  actorType        String   @map("actor_type")
  action           String
  fromState        String?  @map("from_state")
  toState          String?  @map("to_state")
  reason           String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([productId, createdAt])
  @@index([storefrontId, createdAt])
  @@map("moderation_events")
}

/// Provisional restricted-product rules (final policy needs legal/compliance approval, D14).
model RestrictedTerm {
  id          String           @id @default(uuid()) @db.Uuid
  term        String
  /// mkt_normalize(term), maintained by the API.
  normalized  String
  action      RestrictedAction
  categoryId  String?          @map("category_id") @db.Uuid
  note        String?
  active      Boolean          @default(true)
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([active])
  @@map("restricted_terms")
}

/// Saved products / suppliers, per user (A12). Exactly one target (CHECK).
model SavedItem {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  storefrontId String?  @map("storefront_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("saved_items")
}

model ComparisonItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, productId])
  @@map("comparison_items")
}

model RecentlyViewed {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz(3)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@map("recently_viewed")
}

model MarketplacePreference {
  userId      String      @id @map("user_id") @db.Uuid
  categoryIds Json        @default("[]") @map("category_ids")
  emirates    Json        @default("[]")
  defaultView ListingView @default(GRID) @map("default_view")
  defaultSort String      @default("relevance") @map("default_sort")
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("marketplace_preferences")
}

/// Admin-curated featured placements, always labelled "Featured" and never used for search ranking.
model FeaturedListing {
  id           String       @id @default(uuid()) @db.Uuid
  kind         FeaturedKind
  productId    String?      @map("product_id") @db.Uuid
  storefrontId String?      @map("storefront_id") @db.Uuid
  position     Int          @default(0)
  startsAt     DateTime?    @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime?    @map("ends_at") @db.Timestamptz(3)
  reason       String
  createdById  String       @map("created_by_id") @db.Uuid
  removedAt    DateTime?    @map("removed_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([kind, removedAt, position])
  @@map("featured_listings")
}

// ---------------------------------------------------------------------------------------------
// Phase 3: RFQs, versioned quotes and award, scoped conversations, notifications,
// idempotency keys (docs/06-data.md, docs/09-workflows.md). Money: BigInt fils (AED).
// ---------------------------------------------------------------------------------------------

enum RfqState {
  DRAFT
  OPEN
  AWARDED
  CANCELLED
  EXPIRED
}

enum RfqVisibility {
  /// Every eligible seller in the RFQ's category may see and quote.
  POOL
  /// Only the invited sellers may see and quote.
  INVITE
}

enum QuoteState {
  DRAFT
  SUBMITTED
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum QuoteVersionState {
  DRAFT
  SUBMITTED
  SUPERSEDED
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

/// Development tax codes (D06 open): rates come from configuration, not a tax determination.
enum TaxCode {
  STANDARD
  ZERO_RATED
  EXEMPT
}

model Rfq {
  id                     String        @id @default(uuid()) @db.Uuid
  /// Human reference, e.g. RFQ-000123 (sequence-backed).
  number                 String        @unique
  buyerWorkspaceId       String        @map("buyer_workspace_id") @db.Uuid
  buyerCompanyId         String        @map("buyer_company_id") @db.Uuid
  createdById            String        @map("created_by_id") @db.Uuid
  title                  String
  categoryId             String        @map("category_id") @db.Uuid
  specs                  String
  quantity               Int
  unit                   QuantityUnit
  targetDate             DateTime      @map("target_date") @db.Date
  emirate                Emirate
  budgetFils             BigInt?       @map("budget_fils")
  /// Quote submission deadline.
  deadline               DateTime      @db.Timestamptz(3)
  visibility             RfqVisibility @default(POOL)
  state                  RfqState      @default(DRAFT)
  version                Int           @default(1)
  publishedAt            DateTime?     @map("published_at") @db.Timestamptz(3)
  closedAt               DateTime?     @map("closed_at") @db.Timestamptz(3)
  cancelReason           String?       @map("cancel_reason")
  /// Award guard (docs/06-data.md): at most one accepted quote version per RFQ, and per version.
  acceptedQuoteVersionId String?       @unique @map("accepted_quote_version_id") @db.Uuid
  awardedAt              DateTime?     @map("awarded_at") @db.Timestamptz(3)
  /// Payment window after acceptance (A05, QUOTE_PAYMENT_WINDOW_HOURS). Orders: Phase 4.
  paymentDueAt           DateTime?     @map("payment_due_at") @db.Timestamptz(3)
  adminHiddenAt          DateTime?     @map("admin_hidden_at") @db.Timestamptz(3)
  adminHiddenReason      String?       @map("admin_hidden_reason")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  buyerWorkspace       Workspace      @relation("RfqBuyer", fields: [buyerWorkspaceId], references: [id], onDelete: Restrict)
  category             Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  acceptedQuoteVersion QuoteVersion?  @relation("RfqAward", fields: [acceptedQuoteVersionId], references: [id], onDelete: Restrict)
  invites              RfqInvite[]
  files                RfqFile[]
  quotes               Quote[]
  events               RfqEvent[]
  conversations        Conversation[]

  @@index([buyerWorkspaceId, state])
  @@index([categoryId, state, deadline])
  @@index([state, deadline])
  @@map("rfqs")
}

model RfqInvite {
  id                String   @id @default(uuid()) @db.Uuid
  rfqId             String   @map("rfq_id") @db.Uuid
  sellerWorkspaceId String   @map("seller_workspace_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rfq             Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sellerWorkspace Workspace @relation("RfqInviteSeller", fields: [sellerWorkspaceId], references: [id], onDelete: Restrict)

  @@unique([rfqId, sellerWorkspaceId])
  @@index([sellerWorkspaceId])
  @@map("rfq_invites")
}

model RfqFile {
  id        String   @id @default(uuid()) @db.Uuid
  rfqId     String   @map("rfq_id") @db.Uuid
  fileId    String   @unique @map("file_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rfq  Rfq  @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  file File @relation("RfqFileFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@index([rfqId])
  @@map("rfq_files")
}

model Quote {
  id                String     @id @default(uuid()) @db.Uuid
  rfqId             String     @map("rfq_id") @db.Uuid
  sellerWorkspaceId String     @map("seller_workspace_id") @db.Uuid
  sellerCompanyId   String     @map("seller_company_id") @db.Uuid
  state             QuoteState @default(DRAFT)
  /// Latest version (draft or submitted); older submitted versions are SUPERSEDED.
  currentVersionId  String?    @unique @map("current_version_id") @db.Uuid
  version           Int        @default(1)
  createdById       String     @map("created_by_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  rfq             Rfq            @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  sellerWorkspace Workspace      @relation("QuoteSeller", fields: [sellerWorkspaceId], references: [id], onDelete: Restrict)
  currentVersion  QuoteVersion?  @relation("QuoteCurrent", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions        QuoteVersion[] @relation("QuoteVersions")
  events          RfqEvent[]

  @@unique([rfqId, sellerWorkspaceId])
  @@index([sellerWorkspaceId, state])
  @@map("quotes")
}

/// Immutable once SUBMITTED (enforced by trigger): only state transitions may change.
model QuoteVersion {
  id            String            @id @default(uuid()) @db.Uuid
  quoteId       String            @map("quote_id") @db.Uuid
  version       Int
  quantity      Int
  unit          QuantityUnit
  unitPriceFils BigInt            @map("unit_price_fils")
  subtotalFils  BigInt            @map("subtotal_fils")
  shippingFils  BigInt            @map("shipping_fils")
  taxCode       TaxCode           @map("tax_code")
  /// Rate in basis points captured at submission from configuration.
  taxBps        Int               @map("tax_bps")
  taxFils       BigInt            @map("tax_fils")
  totalFils     BigInt            @map("total_fils")
  specs         String
  /// Explicitly flagged deviations from the RFQ requirements.
  deviations    String?
  leadDays      Int               @map("lead_days")
  deliveryDate  DateTime          @map("delivery_date") @db.Date
  validUntil    DateTime          @map("valid_until") @db.Timestamptz(3)
  terms         String?
  state         QuoteVersionState @default(DRAFT)
  submittedAt   DateTime?         @map("submitted_at") @db.Timestamptz(3)
  createdById   String            @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  quote     Quote       @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Restrict)
  currentOf Quote?      @relation("QuoteCurrent")
  awardOf   Rfq?        @relation("RfqAward")
  files     QuoteFile[]

  @@unique([quoteId, version])
  @@map("quote_versions")
}

model QuoteFile {
  id             String   @id @default(uuid()) @db.Uuid
  quoteVersionId String   @map("quote_version_id") @db.Uuid
  fileId         String   @map("file_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Restrict)
  file         File         @relation("QuoteFileFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([quoteVersionId, fileId])
  @@index([fileId])
  @@map("quote_files")
}

/// Append-only RFQ/quote timeline. Seller-side readers only see their own quote's events.
model RfqEvent {
  id             String   @id @default(uuid()) @db.Uuid
  rfqId          String   @map("rfq_id") @db.Uuid
  quoteId        String?  @map("quote_id") @db.Uuid
  quoteVersionId String?  @map("quote_version_id") @db.Uuid
  kind           String
  /// BUYER, SELLER, SYSTEM or ADMIN.
  actorSide      String   @map("actor_side")
  actorId        String?  @map("actor_id") @db.Uuid
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rfq   Rfq    @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  quote Quote? @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@index([rfqId, createdAt])
  @@index([quoteId, createdAt])
  @@map("rfq_events")
}

/// Buyer workspace <-> seller workspace, optionally about one RFQ (orders added in Phase 4).
model Conversation {
  id                String   @id @default(uuid()) @db.Uuid
  buyerWorkspaceId  String   @map("buyer_workspace_id") @db.Uuid
  sellerWorkspaceId String   @map("seller_workspace_id") @db.Uuid
  rfqId             String?  @map("rfq_id") @db.Uuid
  lastMessageAt     DateTime @default(now()) @map("last_message_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  buyerWorkspace  Workspace     @relation("ConversationBuyer", fields: [buyerWorkspaceId], references: [id], onDelete: Restrict)
  sellerWorkspace Workspace     @relation("ConversationSeller", fields: [sellerWorkspaceId], references: [id], onDelete: Restrict)
  rfq             Rfq?          @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  messages        Message[]
  receipts        ReadReceipt[]

  @@index([buyerWorkspaceId, lastMessageAt])
  @@index([sellerWorkspaceId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                String   @id @default(uuid()) @db.Uuid
  conversationId    String   @map("conversation_id") @db.Uuid
  senderId          String   @map("sender_id") @db.Uuid
  senderWorkspaceId String   @map("sender_workspace_id") @db.Uuid
  body              String?
  fileId            String?  @unique @map("file_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  file         File?        @relation("MessageFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model ReadReceipt {
  id                String    @id @default(uuid()) @db.Uuid
  conversationId    String    @map("conversation_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  lastReadMessageId String?   @map("last_read_message_id") @db.Uuid
  lastReadAt        DateTime? @map("last_read_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("read_receipts")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  /// Display data only (ids, titles, references); never private documents or prices of others.
  payload   Json
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Email opt-ins per user. In-app notifications and critical notices cannot be turned off.
model NotificationPreference {
  userId             String    @id @map("user_id") @db.Uuid
  emailRfqs          Boolean   @default(true) @map("email_rfqs")
  emailQuotes        Boolean   @default(true) @map("email_quotes")
  emailMessages      Boolean   @default(false) @map("email_messages")
  /// Marketing email is opt-in only (T36); transactional and security notices ignore it.
  emailMarketing     Boolean   @default(false) @map("email_marketing")
  marketingConsentAt DateTime? @map("marketing_consent_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("notification_preferences")
}

/// Idempotency-Key replay store for award/order/monetary POSTs (docs/07-api.md).
model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  key         String
  route       String
  requestHash String   @map("request_hash")
  statusCode  Int      @map("status_code")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------- Phase 4: cart, checkout, orders, sandbox payments, ledger
// Workspace, company, SKU and user references are plain columns with foreign keys added in the
// migration SQL (no back-relations on Phase 0–2 models).

enum CheckoutState {
  PENDING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
  RECONCILIATION_REQUIRED
}

enum CheckoutSource {
  CART
  QUOTE
}

enum OrderState {
  AWAITING_PAYMENT
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ReservationState {
  HELD
  CONSUMED
  RELEASED
}

enum PaymentState {
  CREATED
  PENDING
  CAPTURED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  QUARANTINED
}

enum ReconciliationKind {
  LATE_CAPTURE
  AMOUNT_MISMATCH
  UNKNOWN_REFERENCE
  INVALID_SIGNATURE
  REFUND_FAILED
  PAYOUT_FAILED
}

enum ReconciliationState {
  OPEN
  RESOLVED
}

enum MockPspSessionState {
  OPEN
  CAPTURED
  FAILED
  CANCELLED
}

/// Buyer delivery/billing addresses (UAE only). Orders keep a snapshot; archived, never deleted when used.
model Address {
  id               String    @id @default(uuid()) @db.Uuid
  buyerWorkspaceId String    @map("buyer_workspace_id") @db.Uuid
  label            String
  recipient        String
  phone            String
  line1            String
  line2            String?
  city             String
  emirate          Emirate
  isDefault        Boolean   @default(false) @map("is_default")
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([buyerWorkspaceId, archivedAt])
  @@map("addresses")
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  buyerWorkspaceId String   @map("buyer_workspace_id") @db.Uuid
  skuId            String   @map("sku_id") @db.Uuid
  quantity         Int
  addedById        String   @map("added_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([buyerWorkspaceId, skuId])
  @@map("cart_items")
}

model Checkout {
  id                   String         @id @default(uuid()) @db.Uuid
  number               String         @unique
  buyerWorkspaceId     String         @map("buyer_workspace_id") @db.Uuid
  buyerCompanyId       String         @map("buyer_company_id") @db.Uuid
  createdById          String         @map("created_by_id") @db.Uuid
  source               CheckoutSource
  state                CheckoutState  @default(PENDING_PAYMENT)
  rfqId                String?        @unique @map("rfq_id") @db.Uuid
  quoteVersionId       String?        @unique @map("quote_version_id") @db.Uuid
  addressSnapshot      Json?          @map("address_snapshot")
  poReference          String?        @map("po_reference")
  merchandiseFils      BigInt         @map("merchandise_fils")
  shippingFils         BigInt         @map("shipping_fils")
  taxFils              BigInt         @map("tax_fils")
  totalFils            BigInt         @map("total_fils")
  currency             String         @default("AED")
  /// Rule versions in force when the totals were computed (docs/08-finance.md snapshots).
  taxRule              Json           @map("tax_rule")
  commissionBps        Int            @map("commission_bps")
  /// Commission policy version in force at checkout (null: env/sandbox rate before any policy).
  commissionPolicyId   String?        @map("commission_policy_id") @db.Uuid
  /// Stock hold for cart checkouts (D11); null for quote checkouts (no stock).
  reservationExpiresAt DateTime?      @map("reservation_expires_at") @db.Timestamptz(3)
  /// Last moment the buyer may pay (cart: reservation expiry; quote: A05 payment window).
  payBy                DateTime       @map("pay_by") @db.Timestamptz(3)
  paidAt               DateTime?      @map("paid_at") @db.Timestamptz(3)
  closedAt             DateTime?      @map("closed_at") @db.Timestamptz(3)
  version              Int            @default(1)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders           Order[]
  reservations     Reservation[]
  payments         Payment[]
  commissionPolicy CommissionPolicy? @relation(fields: [commissionPolicyId], references: [id], onDelete: Restrict)

  @@index([buyerWorkspaceId, state])
  @@index([state, payBy])
  @@map("checkouts")
}

model Order {
  id                      String          @id @default(uuid()) @db.Uuid
  number                  String          @unique
  checkoutId              String          @map("checkout_id") @db.Uuid
  buyerWorkspaceId        String          @map("buyer_workspace_id") @db.Uuid
  buyerCompanyId          String          @map("buyer_company_id") @db.Uuid
  sellerWorkspaceId       String          @map("seller_workspace_id") @db.Uuid
  sellerCompanyId         String          @map("seller_company_id") @db.Uuid
  state                   OrderState      @default(AWAITING_PAYMENT)
  merchandiseFils         BigInt          @map("merchandise_fils")
  shippingFils            BigInt          @map("shipping_fils")
  taxFils                 BigInt          @map("tax_fils")
  totalFils               BigInt          @map("total_fils")
  commissionFils          BigInt          @map("commission_fils")
  sellerPayableFils       BigInt          @map("seller_payable_fils")
  /// Buyer, seller and delivery terms as agreed at checkout (never re-read from live data).
  snapshot                Json
  confirmedAt             DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt             DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelReason            String?         @map("cancel_reason")
  settlementState         SettlementState @default(NOT_ELIGIBLE) @map("settlement_state")
  refundedFils            BigInt          @default(0) @map("refunded_fils")
  processingAt            DateTime?       @map("processing_at") @db.Timestamptz(3)
  dispatchedAt            DateTime?       @map("dispatched_at") @db.Timestamptz(3)
  deliveredAt             DateTime?       @map("delivered_at") @db.Timestamptz(3)
  completedAt             DateTime?       @map("completed_at") @db.Timestamptz(3)
  /// Commission rate (basis points of merchandise) and policy this order was priced with.
  commissionBps           Int?            @map("commission_bps")
  commissionPolicyId      String?         @map("commission_policy_id") @db.Uuid
  /// Verified delivery (C-02): supplier delivery with proof, or buyer receipt, whichever is first.
  deliveryVerifiedAt      DateTime?       @map("delivery_verified_at") @db.Timestamptz(3)
  /// PROOF_OF_DELIVERY or BUYER_CONFIRMED.
  deliveryVerification    String?         @map("delivery_verification")
  /// Disputes can be opened until this moment; payouts only after it (C-01).
  disputeWindowEndsAt     DateTime?       @map("dispute_window_ends_at") @db.Timestamptz(3)
  version                 Int             @default(1)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// C-07: supplier asked to cancel (fulfilment stops until finance decides the full refund).
  sellerCancelRequestedAt DateTime?       @map("seller_cancel_requested_at") @db.Timestamptz(3)
  sellerCancelReason      String?         @map("seller_cancel_reason")

  checkout         Checkout          @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  commissionPolicy CommissionPolicy? @relation(fields: [commissionPolicyId], references: [id], onDelete: Restrict)
  lines            OrderLine[]
  events           OrderEvent[]
  shipment         Shipment?
  disputes         Dispute[]
  refunds          Refund[]
  review           Review?
  holds            OrderHold[]

  @@index([buyerWorkspaceId, state, createdAt])
  @@index([sellerWorkspaceId, state, createdAt])
  @@index([checkoutId])
  @@map("orders")
}

model OrderLine {
  id             String       @id @default(uuid()) @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  position       Int
  skuId          String?      @map("sku_id") @db.Uuid
  productId      String?      @map("product_id") @db.Uuid
  quoteVersionId String?      @map("quote_version_id") @db.Uuid
  title          String
  skuCode        String?      @map("sku_code")
  variant        Json         @default("{}")
  unit           QuantityUnit
  quantity       Int
  unitPriceFils  BigInt       @map("unit_price_fils")
  lineTotalFils  BigInt       @map("line_total_fils")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, position])
  @@map("order_lines")
}

/// Append-only order timeline.
model OrderEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  kind      String
  actorSide String   @map("actor_side")
  actorId   String?  @map("actor_id") @db.Uuid
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model Reservation {
  id         String           @id @default(uuid()) @db.Uuid
  checkoutId String           @map("checkout_id") @db.Uuid
  skuId      String           @map("sku_id") @db.Uuid
  quantity   Int
  state      ReservationState @default(HELD)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  closedAt   DateTime?        @map("closed_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  checkout Checkout @relation(fields: [checkoutId], references: [id], onDelete: Restrict)

  @@unique([checkoutId, skuId])
  @@index([state, expiresAt])
  @@map("reservations")
}

model Payment {
  id             String       @id @default(uuid()) @db.Uuid
  checkoutId     String       @map("checkout_id") @db.Uuid
  provider       String
  providerRef    String       @unique @map("provider_ref")
  idempotencyKey String       @unique @map("idempotency_key")
  state          PaymentState @default(CREATED)
  amountFils     BigInt       @map("amount_fils")
  currency       String       @default("AED")
  sandbox        Boolean
  capturedAt     DateTime?    @map("captured_at") @db.Timestamptz(3)
  failureCode    String?      @map("failure_code")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  checkout Checkout @relation(fields: [checkoutId], references: [id], onDelete: Restrict)

  @@index([checkoutId])
  @@map("payments")
}

/// Durable webhook inbox: every provider event is stored before processing (docs/08-finance.md).
model PaymentEvent {
  id             String             @id @default(uuid()) @db.Uuid
  provider       String
  eventId        String             @map("event_id")
  type           String
  providerRef    String?            @map("provider_ref")
  amountFils     BigInt?            @map("amount_fils")
  currency       String?
  signatureValid Boolean            @map("signature_valid")
  payload        Json
  status         PaymentEventStatus @default(RECEIVED)
  error          String?
  receivedAt     DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime?          @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@map("payment_events")
}

/// Operational ledger (not statutory accounting). Journals balance; entries are append-only.
model LedgerJournal {
  id         String   @id @default(uuid()) @db.Uuid
  kind       String
  checkoutId String?  @map("checkout_id") @db.Uuid
  paymentId  String?  @map("payment_id") @db.Uuid
  /// One journal per business event (e.g. capture:<paymentId>), so replays cannot double-post.
  dedupeKey  String   @unique @map("dedupe_key")
  memo       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@map("ledger_journals")
}

model LedgerEntry {
  id                String  @id @default(uuid()) @db.Uuid
  journalId         String  @map("journal_id") @db.Uuid
  account           String
  debitFils         BigInt  @default(0) @map("debit_fils")
  creditFils        BigInt  @default(0) @map("credit_fils")
  orderId           String? @map("order_id") @db.Uuid
  sellerWorkspaceId String? @map("seller_workspace_id") @db.Uuid

  journal LedgerJournal @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@index([journalId])
  @@index([account])
  @@map("ledger_entries")
}

model ReconciliationCase {
  id             String              @id @default(uuid()) @db.Uuid
  kind           ReconciliationKind
  state          ReconciliationState @default(OPEN)
  checkoutId     String?             @map("checkout_id") @db.Uuid
  paymentId      String?             @map("payment_id") @db.Uuid
  paymentEventId String?             @map("payment_event_id") @db.Uuid
  details        Json
  resolution     String?
  resolvedById   String?             @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?           @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([state, createdAt])
  @@map("reconciliation_cases")
}

/// Sandbox-only stand-in for a hosted PSP checkout (PAYMENT_MODE=mock). Never used in production.
model MockPspSession {
  id             String              @id
  amountFils     BigInt              @map("amount_fils")
  currency       String
  reference      String
  idempotencyKey String              @unique @map("idempotency_key")
  returnUrl      String              @map("return_url")
  state          MockPspSessionState @default(OPEN)
  /// Pending webhook deliveries (JSON array of events not yet posted to the API).
  outbox         Json                @default("[]")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("mock_psp_sessions")
}

// ------------------------------------------------------------------ Phase 5: fulfilment and settlement

enum SettlementState {
  NOT_ELIGIBLE
  ELIGIBLE
  HELD
  IN_PAYOUT
  PAID_OUT
}

enum ShipmentState {
  DISPATCHED
  DELIVERED
}

enum DisputeState {
  OPEN
  UNDER_REVIEW
  AWAITING_EVIDENCE
  RESOLUTION_PROPOSED
  RESOLVING
  CLOSED
}

enum DisputeType {
  NOT_RECEIVED
  DAMAGED
  WRONG_ITEMS
  QUANTITY_SHORT
  QUALITY
  OTHER
}

enum DisputeProposal {
  NO_ACTION
  REFUND
}

enum RefundState {
  REQUESTED
  APPROVED
  REJECTED
  SUBMITTED
  SUCCEEDED
  FAILED
}

enum PayoutState {
  PROPOSED
  REQUESTED
  APPROVED
  REJECTED
  PENDING
  PAID
  FAILED
}

enum ReviewState {
  PUBLISHED
  HIDDEN
}

enum MockPspOperationKind {
  REFUND
  PAYOUT
}

enum MockPspOperationState {
  OPEN
  SUCCEEDED
  FAILED
}

/// One shipment per seller order (MVP), containing every line.
model Shipment {
  id                   String        @id @default(uuid()) @db.Uuid
  orderId              String        @unique @map("order_id") @db.Uuid
  carrier              String
  trackingCode         String?       @map("tracking_code")
  expectedDeliveryDate DateTime?     @map("expected_delivery_date") @db.Date
  state                ShipmentState @default(DISPATCHED)
  dispatchedAt         DateTime      @default(now()) @map("dispatched_at") @db.Timestamptz(3)
  dispatchedById       String        @map("dispatched_by_id") @db.Uuid
  deliveredAt          DateTime?     @map("delivered_at") @db.Timestamptz(3)
  deliveredById        String?       @map("delivered_by_id") @db.Uuid
  deliveryNote         String?       @map("delivery_note")
  proofFileId          String?       @map("proof_file_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items ShipmentItem[]

  @@map("shipments")
}

model ShipmentItem {
  id          String @id @default(uuid()) @db.Uuid
  shipmentId  String @map("shipment_id") @db.Uuid
  orderLineId String @map("order_line_id") @db.Uuid
  quantity    Int

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderLineId])
  @@map("shipment_items")
}

model Dispute {
  id                 String           @id @default(uuid()) @db.Uuid
  number             String           @unique
  orderId            String           @map("order_id") @db.Uuid
  openedById         String           @map("opened_by_id") @db.Uuid
  openedSide         String           @map("opened_side")
  type               DisputeType
  state              DisputeState     @default(OPEN)
  reason             String
  assignedAdminId    String?          @map("assigned_admin_id") @db.Uuid
  proposal           DisputeProposal?
  proposalAmountFils BigInt?          @map("proposal_amount_fils")
  proposalNote       String?          @map("proposal_note")
  resolution         String?
  closedAt           DateTime?        @map("closed_at") @db.Timestamptz(3)
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  messages DisputeMessage[]
  refunds  Refund[]

  @@index([state, createdAt])
  @@map("disputes")
}

/// Append-only case history (messages and evidence).
model DisputeMessage {
  id         String   @id @default(uuid()) @db.Uuid
  disputeId  String   @map("dispute_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  authorSide String   @map("author_side")
  body       String
  fileId     String?  @map("file_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Restrict)

  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

model Refund {
  id                 String      @id @default(uuid()) @db.Uuid
  number             String      @unique
  orderId            String      @map("order_id") @db.Uuid
  paymentId          String      @map("payment_id") @db.Uuid
  disputeId          String?     @map("dispute_id") @db.Uuid
  amountFils         BigInt      @map("amount_fils")
  /// Commission share reversed with this refund (merchandise part only since Phase 8, C-06).
  commissionFils     BigInt      @map("commission_fils")
  /// Parts of the order this refund covers; null on refunds made before Phase 8.
  merchandiseFils    BigInt?     @map("merchandise_fils")
  shippingFils       BigInt?     @map("shipping_fils")
  taxFils            BigInt?     @map("tax_fils")
  currency           String      @default("AED")
  state              RefundState @default(REQUESTED)
  reason             String
  /// C-07: requested by the supplier cancelling an unfulfilled order.
  sellerCancellation Boolean     @default(false) @map("seller_cancellation")
  requestedById      String      @map("requested_by_id") @db.Uuid
  approvedById       String?     @map("approved_by_id") @db.Uuid
  decisionReason     String?     @map("decision_reason")
  providerRef        String?     @unique @map("provider_ref")
  failureCode        String?     @map("failure_code")
  submittedAt        DateTime?   @map("submitted_at") @db.Timestamptz(3)
  completedAt        DateTime?   @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  dispute Dispute? @relation(fields: [disputeId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([state, createdAt])
  @@map("refunds")
}

model Payout {
  id                String      @id @default(uuid()) @db.Uuid
  number            String      @unique
  sellerWorkspaceId String      @map("seller_workspace_id") @db.Uuid
  sellerCompanyId   String      @map("seller_company_id") @db.Uuid
  amountFils        BigInt      @map("amount_fils")
  currency          String      @default("AED")
  state             PayoutState @default(REQUESTED)
  /// Null while PROPOSED by the weekly schedule; set when a finance user confirms the proposal.
  requestedById     String?     @map("requested_by_id") @db.Uuid
  approvedById      String?     @map("approved_by_id") @db.Uuid
  decisionReason    String?     @map("decision_reason")
  proposedAt        DateTime?   @map("proposed_at") @db.Timestamptz(3)
  providerRef       String?     @unique @map("provider_ref")
  failureCode       String?     @map("failure_code")
  submittedAt       DateTime?   @map("submitted_at") @db.Timestamptz(3)
  paidAt            DateTime?   @map("paid_at") @db.Timestamptz(3)
  /// Weekly payout run (Dubai week); one live payout per supplier per run (C-04).
  runId             String?     @map("run_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  allocations PayoutAllocation[]
  run         PayoutRun?         @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([sellerWorkspaceId, createdAt])
  @@map("payouts")
}

model PayoutAllocation {
  id         String @id @default(uuid()) @db.Uuid
  payoutId   String @map("payout_id") @db.Uuid
  orderId    String @map("order_id") @db.Uuid
  amountFils BigInt @map("amount_fils")

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@unique([payoutId, orderId])
  @@index([orderId])
  @@map("payout_allocations")
}

model Review {
  id                String      @id @default(uuid()) @db.Uuid
  orderId           String      @unique @map("order_id") @db.Uuid
  buyerWorkspaceId  String      @map("buyer_workspace_id") @db.Uuid
  sellerWorkspaceId String      @map("seller_workspace_id") @db.Uuid
  authorId          String      @map("author_id") @db.Uuid
  rating            Int         @db.SmallInt
  comment           String?
  state             ReviewState @default(PUBLISHED)
  hiddenReason      String?     @map("hidden_reason")
  hiddenById        String?     @map("hidden_by_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([sellerWorkspaceId, state, createdAt])
  @@map("reviews")
}

/// Sandbox-only stand-in for provider refund and payout operations (PAYMENT_MODE=mock).
model MockPspOperation {
  id             String                @id
  kind           MockPspOperationKind
  amountFils     BigInt                @map("amount_fils")
  currency       String
  reference      String
  idempotencyKey String                @unique @map("idempotency_key")
  state          MockPspOperationState @default(OPEN)
  /// Pending webhook deliveries (JSON array of events not yet posted to the API).
  outbox         Json                  @default("[]")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("mock_psp_operations")
}

// ------------------------------------------------------------------ Phase 6: support and exports

enum SupportTicketState {
  OPEN
  ASSIGNED
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportCategory {
  ACCOUNT
  VERIFICATION
  ORDER
  PAYMENT
  RFQ
  CATALOG
  OTHER
  SECURITY
  COMPLIANCE
}

enum ExportState {
  READY
  EXPIRED
}

/// Customer support case for one company workspace (docs/09-workflows.md support ticket).
model SupportTicket {
  id              String             @id @default(uuid()) @db.Uuid
  number          String             @unique
  workspaceId     String             @map("workspace_id") @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  openedById      String             @map("opened_by_id") @db.Uuid
  category        SupportCategory
  subject         String
  state           SupportTicketState @default(OPEN)
  orderId         String?            @map("order_id") @db.Uuid
  rfqId           String?            @map("rfq_id") @db.Uuid
  assignedAdminId String?            @map("assigned_admin_id") @db.Uuid
  version         Int                @default(1)
  lastCustomerAt  DateTime?          @map("last_customer_at") @db.Timestamptz(3)
  lastAdminAt     DateTime?          @map("last_admin_at") @db.Timestamptz(3)
  resolvedAt      DateTime?          @map("resolved_at") @db.Timestamptz(3)
  closedAt        DateTime?          @map("closed_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  messages SupportMessage[]

  @@index([workspaceId, createdAt])
  @@index([state, createdAt])
  @@index([assignedAdminId, state])
  @@map("support_tickets")
}

/// Append-only support conversation (database trigger rejects UPDATE/DELETE/TRUNCATE).
model SupportMessage {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  authorSide String   @map("author_side")
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

/// Scoped admin CSV export with an expiring download (docs/04-admin.md /reports, T41).
model ExportJob {
  id            String      @id @default(uuid()) @db.Uuid
  requestedById String      @map("requested_by_id") @db.Uuid
  reportType    String      @map("report_type")
  scope         String
  filters       Json        @default("{}")
  reason        String
  rowCount      Int         @map("row_count")
  content       Bytes?
  sha256        String
  state         ExportState @default(READY)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(3)
  downloadedAt  DateTime?   @map("downloaded_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([requestedById, createdAt])
  @@index([state, expiresAt])
  @@map("export_jobs")
}

// ------------------------------------------------------------------ Phase 8 financial policies

enum OrderHoldKind {
  COMPLIANCE
  FRAUD
  RECONCILIATION
  PAYMENT_INVESTIGATION
}

/// Versioned, append-only commission policy (C-05). The newest version prices new checkouts.
model CommissionPolicy {
  id            String   @id @default(uuid()) @db.Uuid
  version       Int      @unique
  rateBps       Int      @map("rate_bps")
  base          String   @default("MERCHANDISE_EX_VAT_DELIVERY")
  reason        String
  createdById   String?  @map("created_by_id") @db.Uuid
  /// Applies to checkouts created from this time; set at least the notice period ahead.
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  checkouts Checkout[]
  orders    Order[]

  @@index([effectiveFrom])
  @@map("commission_policies")
}

/// Compliance, fraud, reconciliation or payment-investigation hold on an order's settlement.
/// Never deleted; released once with a reason (C-03, C-04).
model OrderHold {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  kind          OrderHoldKind
  reason        String
  placedById    String        @map("placed_by_id") @db.Uuid
  placedAt      DateTime      @default(now()) @map("placed_at") @db.Timestamptz(3)
  releasedById  String?       @map("released_by_id") @db.Uuid
  releasedAt    DateTime?     @map("released_at") @db.Timestamptz(3)
  releaseReason String?       @map("release_reason")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_holds")
}

/// Weekly payout run (Dubai calendar week starting Monday).
model PayoutRun {
  id            String    @id @default(uuid()) @db.Uuid
  weekStart     DateTime  @unique @map("week_start") @db.Date
  /// When the weekly schedule was due (Monday 10:00 Dubai by default, moved past holidays).
  scheduledFor  DateTime? @map("scheduled_for") @db.Timestamptz(3)
  proposedAt    DateTime? @map("proposed_at") @db.Timestamptz(3)
  proposedCount Int?      @map("proposed_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  payouts Payout[]

  @@map("payout_runs")
}

/// UAE public holidays that move the weekly payout run to the next working day.
model PayoutHoliday {
  date        DateTime @id @db.Date
  name        String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("payout_holidays")
}

enum VatRegistrationStatus {
  UNKNOWN
  REGISTERED
  NOT_REGISTERED
}

/// Recurring background task with a lease (Phase 8, PostgreSQL scheduler replacing BullMQ).
model BackgroundTask {
  name                String    @id
  everySeconds        Int       @map("every_seconds")
  nextRunAt           DateTime  @default(now()) @map("next_run_at") @db.Timestamptz(3)
  leaseOwner          String?   @map("lease_owner")
  leaseExpiresAt      DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  lastStartedAt       DateTime? @map("last_started_at") @db.Timestamptz(3)
  lastFinishedAt      DateTime? @map("last_finished_at") @db.Timestamptz(3)
  lastStatus          String?   @map("last_status")
  lastError           String?   @map("last_error")
  lastResult          Json?     @map("last_result")
  runCount            Int       @default(0) @map("run_count")
  failureCount        Int       @default(0) @map("failure_count")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([nextRunAt])
  @@map("background_tasks")
}
