# Local development defaults. Placeholders only: never commit real secrets.
# Copy to .env (git-ignored). Production values come from a secret manager and are
# validated at startup; production refuses mock modes, weak secrets and missing keys.

NODE_ENV=development
# Deployment profile: development | test | staging | production. Unset follows NODE_ENV.
# staging = production build on free services with fictional data only (see docs/phase-8/staging.md).
# APP_ENV=
LOG_LEVEL=info
APP_LOCALE=en

# docker compose services (see docker-compose.yml)
DATABASE_URL=postgresql://marketplace:marketplace-dev-only@localhost:5432/marketplace
# Optional: rate limits and TOTP replay markers use Redis when set, PostgreSQL otherwise.
REDIS_URL=redis://localhost:6379

# >= 32 random chars in production; this placeholder is rejected there.
SESSION_SECRET=dev-only-session-secret-change-me-0000
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts admin TOTP secrets. This example key is rejected in production.
MFA_ENCRYPTION_KEY=ZGV2LW9ubHktbWZhLWtleS0zMi1ieXRlcy1sb25nISE=

# Configurable working name until branding is approved (A06)
APP_NAME=B2B Marketplace (working name)

WEB_ORIGIN=http://localhost:3000
# Admin portal: separate origin (A03). *.localhost resolves to loopback in browsers.
ADMIN_ORIGIN=http://admin.localhost:3000
API_ORIGIN=http://localhost:4000
API_PORT=4000
WORKER_HEALTH_PORT=4100

# s3 (S3-compatible, local SeaweedFS) | vercel-blob (private Vercel Blob store, C-21)
STORAGE_DRIVER=s3
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# Local S3-compatible storage (SeaweedFS in docker compose).
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=me-central-1
STORAGE_BUCKET=marketplace-private-dev
STORAGE_ACCESS_KEY=dev-only-access-key
STORAGE_SECRET_KEY=dev-only-secret-key

# disabled | sandbox-eicar (development only: flags the EICAR test file as infected) | live (required in production)
FILE_SCANNER=sandbox-eicar
UPLOAD_MAX_BYTES=10485760

# Hours a buyer has to pay after quote acceptance (A05). Used from Phase 3/4.
QUOTE_PAYMENT_WINDOW_HOURS=72
# Quote tax rate for the STANDARD code in basis points. Sandbox fixture only (D06 is open);
# production refuses to start without an explicit, approved value.
TAX_STANDARD_BPS=500
# How VAT is decided (F05): provisional_standard (labelled, development only) or supplier_status
# (follows each supplier's VAT registration as confirmed by compliance). Production requires
# supplier_status and TAX_APPROVAL_REFERENCE (the tax professional's written approval).
TAX_TREATMENT=provisional_standard
# TAX_APPROVAL_REFERENCE=
# Platform commission on merchandise in basis points. Sandbox fixture only (D05 is open);
# production refuses to start without an explicit, approved value.
COMMISSION_BPS=1000
# Days after verified delivery during which disputes can be opened; payouts wait for it (founder: 14).
DISPUTE_WINDOW_DAYS=14
# Minutes a checkout holds stock while payment is pending (D11).
RESERVATION_MINUTES=15

# disabled | smtp-dev (local Mailpit catcher, UI http://localhost:8025)
# | catcher (staging: stored 7 days, shown in the admin "Staging mailbox", never sent) | live
EMAIL_PROVIDER=smtp-dev
SMTP_URL=smtp://localhost:1025
EMAIL_API_KEY=
EMAIL_FROM=no-reply@marketplace.invalid

# disabled | mock (sandbox adapter, labelled test mode) | live (production only, after launch gates)
PAYMENT_MODE=mock
PSP_API_KEY=
PSP_WEBHOOK_SECRET=

# Feature flags. All default false. Real payments require founder sign-off (docs/00-decisions.md D05).
TRADING_ENABLED=false
FEATURE_REAL_PAYMENTS=false
FEATURE_SUBSCRIPTIONS=false
FEATURE_MILESTONE_PAYMENTS=false

# Bearer secret for the scheduled background-task function (Vercel Cron sends
# "Authorization: Bearer <CRON_SECRET>"). Leave unset locally: the long-running worker
# (pnpm --filter @app/worker dev) runs the same tasks. Production: at least 32 random characters.
# CRON_SECRET=

# Staging only (APP_ENV=staging): password in front of every web/admin page and the fictional
# email domains allowed to register. Both required in staging; ignored elsewhere.
# STAGING_ACCESS_USER=staging
# STAGING_ACCESS_PASSWORD=
# STAGING_ALLOWED_EMAIL_DOMAINS=example.test
