{
  "name": "uae-b2b-marketplace",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12 <23",
    "pnpm": ">=10.28 <11"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter @app/api --filter @app/web --filter @app/worker run dev",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "test": "pnpm build:packages && pnpm -r --workspace-concurrency=1 run test",
    "test:e2e": "pnpm --filter @app/e2e run test:e2e",
    "db:migrate": "pnpm --filter @app/db run db:migrate",
    "db:migrate:dev": "pnpm --filter @app/db run db:migrate:dev",
    "db:migrate:status": "pnpm --filter @app/db run db:migrate:status",
    "db:seed": "pnpm --filter @app/api run db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:packages": "pnpm --filter './packages/*' run build",
    "dev:totp": "pnpm --silent --filter @app/api run dev:totp",
    "check:production-refusal": "node scripts/production-refusal-check.mjs",
    "db:restore-check": "node scripts/backup-restore-check.mjs",
    "perf:check": "node scripts/perf-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.29",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.9",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
