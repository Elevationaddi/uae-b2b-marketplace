monthly_budget_usd        = 1653
budget_start_date         = "2027-01-01T00:00:00Z"
certificate_key_vault_id = "/subscriptions/<sub>/resourceGroups/rg-uaeb2b-tfstate/providers/Microsoft.KeyVault/vaults/kv-uaeb2b-cert-prd"
