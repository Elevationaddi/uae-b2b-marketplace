# Copy to terraform.tfvars (git-ignored). No secrets belong here.
subscription_id           = "00000000-0000-0000-0000-000000000000"
image_tag                 = "<git-sha>"
public_hostnames          = { web = "www.example.ae", admin = "admin.example.ae" }
tls_certificate_secret_id = "https://kv-uaeb2b-cert-prd.vault.azure.net/secrets/public-hosts"
