    "test": "node ../../scripts/with-env.mjs vitest run"
  },
  "dependencies": {
    "@app/config": "workspace:*",
    "@app/db": "workspace:*",
    "bullmq": "5.61.2",
    "ioredis": "5.11.1",
    "nodemailer": "7.0.13",
    "pino": "9.14.0"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/nodemailer": "7.0.12",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
