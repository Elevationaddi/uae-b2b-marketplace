{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/with-env.mjs vitest run",
    "db:seed": "node ../../scripts/with-env.mjs tsx src/cli/seed.ts",
    "admin:create": "node ../../scripts/with-env.mjs tsx src/cli/create-admin.ts",
    "dev:totp": "tsx src/cli/totp.ts"
  },
  "dependencies": {
    "@app/config": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/db": "workspace:*",
    "@aws-sdk/client-s3": "3.1099.0",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "otplib": "12.0.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "qrcode": "1.5.4",
    "rate-limiter-flexible": "11.4.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.29",
    "@swc/core": "1.13.21",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.3",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.7",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
