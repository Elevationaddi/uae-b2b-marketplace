    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.29",
    "@swc/core": "1.13.21",
    "@types/express": "5.0.3",
    "@types/node": "22.20.7",
    "@types/supertest": "6.0.3",
